 2. OLED 아래쪽에 심박 그래프를 그립니다.\n# 3. 박동과 박동 사이의 시간을 이용하여 BPM을 계산합니다.\n# 4. OLED 위쪽에 현재 BPM을 숫자로 표시합니다.\n#\n# 주의\n# 이 코드는 일반 파이썬이나 MicroPython 코드가 아니라\n# MakeCode 편집기의 'Python' 화면에서 사용하는 코드입니다.\n# ============================================================\n\n\n# ------------------------------------------------------------\n# 1. 측정값과 계산 결과를 저장할 변수\n# ------------------------------------------------------------\n\n# 현재 계산된 분당 심박수입니다.\n# 아직 심박수가 계산되지 않았을 때는 0입니다.\nbpm = 0\n\n# 심박 센서에서 읽은 현재 아날로그 값입니다.\n# micro:bit의 아날로그 입력값 범위는 0~1023입니다.\nsensor_value = 0\n\n# 현재 프로그램이 실행된 시간입니다.\n# 단위는 밀리초(ms)입니다.\nnow = 0\n\n# 이전 심장 박동이 감지된 시각입니다.\n# 단위는 밀리초(ms)입니다.\nlast_beat = 0\n\n# 이전 박동과 현재 박동 사이의 시간입니다.\n# 예: 1초마다 박동하면 1000ms입니다.\nbeat_interval = 0\n\n# 이번에 새로 계산한 BPM입니다.\nnew_bpm = 0\n\n\n# ------------------------------------------------------------\n# 2. 박동을 한 번만 감지하기 위한 변수\n# ------------------------------------------------------------\n\n# 센서값이 기준값을 넘었을 때 박동을 한 번만 세도록 합니다.\n#\n# True  : 새로운 박동을 감지할 준비가 된 상태\n# False : 현재 박동을 이미 감지한 상태\nbeat_armed = True\n\n# 큰 하트를 잠시 보여 준 뒤\n# 작은 하트로 되돌릴 시간을 저장합니다.\nheart_off_time = 0\n\n\n# ------------------------------------------------------------\n# 3. 심박 감지 기준값\n# ------------------------------------------------------------\n\n# 센서값이 이 값보다 커지면 박동이 시작된 것으로 판단합니다.\n# 키트 설명서의 예제값인 600을 기본값으로 사용합니다.\nTHRESHOLD_HIGH = 600\n\n# 센서값이 이 값보다 작아지면\n# 다음 박동을 감지할 준비를 합니다.\n#\n# HIGH와 LOW를 다르게 설정하는 이유는\n# 센서값이 600 근처에서 흔들릴 때 한 박동을 여러 번 세는\n# 현상을 줄이기 위해서입니다.\nTHRESHOLD_LOW = 550\n\n\n# ------------------------------------------------------------\n# 4. 정상적인 BPM 범위\n# ------------------------------------------------------------\n\n# 300ms보다 빠르게 박동이 감지되면\n# 1분에 200회보다 빠른 값이 됩니다.\nMIN_INTERVAL = 300\n\n# 1500ms보다 느리게 박동이 감지되면\n# 1분에 40회보다 느린 값이 됩니다.\nMAX_INTERVAL = 1500\n\n\n# ------------------------------------------------------------\n# 5. OLED 그래프에 사용하는 변수\n# ------------------------------------------------------------\n\n# 현재 그래프를 그릴 가로 위치입니다.\ngraph_x = 0\n\n# 현재 센서값을 OLED의 세로 좌표로 변환한 값입니다.\ngraph_y = 63\n\n# 바로 전에 그렸던 그래프의 세로 위치입니다.\nprevious_y = 63\n\n# OLED 위쪽은 BPM 숫자를 표시하는 공간으로 남겨 둡니다.\n# 그래프는 y=20부터 y=63 사이에 그립니다.\nGRAPH_TOP = 20\nGRAPH_BOTTOM = 63\n\n# 심박 센서값을 그래프로 변환할 때 사용할 범위입니다.\n# 200보다 작은 값은 200으로,\n# 900보다 큰 값은 900으로 제한합니다.\nSIGNAL_MIN = 200\nSIGNAL_MAX = 900\n\n\n# ------------------------------------------------------------\n# 6. OLED 시작 설정\n# ------------------------------------------------------------\n\n# OLED의 크기를 128×64로 설정합니다.\nOLED.init(128, 64)\n\n# OLED 화면을 모두 지웁니다.\nOLED.clear()\n\n# micro:bit LED에는 작은 하트를 표시합니다.\nbasic.show_icon(IconNames.SMALL_HEART)\n\n\n# ------------------------------------------------------------\n# 7. OLED 화면을 새로 그리는 함수\n# ------------------------------------------------------------\n\ndef redraw_oled():\n    OLED.clear()     # 화면에 있던 문자와 그래프를 모두 지웁니다.\n    OLED.write_string(\"BPM: \") # OLED 첫 번째 줄에 \"BPM: \"을 표시합니다.\n\n\n    # 현재 계산된 BPM을 표시하고 다음 줄로 이동합니다.\n    OLED.write_num_new_line(bpm)\n\n    # 숫자 영역과 그래프 영역을 구분하는 선을 그립니다.\n    OLED.draw_line(0, 16, 127, 16)\n\n\n# 프로그램 시작 시 OLED의 기본 화면을 한 번 그립니다.\nredraw_oled()\n# 8. 심박수 측정 및 그래프 출력\n\n\ndef on_forever():\n    global bpm\n    global sensor_value\n    global now\n    global last_beat\n    global beat_interval\n    global new_bpm\n    global beat_armed\n    global heart_off_time\n    global graph_x\n    global graph_y\n    global previous_y\n\n    # --------------------------------------------------------\n    # 8-1. 심박 센서값 읽기\n    # --------------------------------------------------------\n\n    # P1 핀에 연결된 심박 센서의 아날로그 값을 읽습니다.\n    sensor_value = pins.analog_read_pin(AnalogReadWritePin.P1)\n\n    # 프로그램이 시작된 후 지금까지 지난 시간을 가져옵니다.밀리초입니다.\n    now = input.running_time()\n\n    # 8-2. 새로운 박동 감지 \n    # 센서값이 높은 기준값을 넘었고,새로운 박동을 감지할 준비가 되어 있는지 확인합니다.\n    if sensor_value > THRESHOLD_HIGH and beat_armed:\n\n        # 현재 박동을 이미 감지했으므로   같은 박동을 다시 세지 않도록 False로 바꿉니다.\n        beat_armed = False\n\n        # micro:bit LED에 큰 하트를 표시합니다.\n        basic.show_icon(IconNames.HEART)\n\n        # 120ms 후 작은 하트로 되돌리기 위해 시간을 기록합니다.\n        heart_off_time = now + 120\n\n        # last_beat가 0이면 첫 번째 박동입니다.첫 번째 박동만으로는 박동 사이의 시간을 계산할 수 없습니다.\n        if last_beat > 0:\n\n            # 현재 박동 시각에서 이전 박동 시각을 뺍니다.\n            beat_interval = now - last_beat\n\n            # 너무 빠르거나 너무 느린 신호는\n            # 센서 잡음일 수 있으므로 계산에서 제외합니다.\n            if beat_interval >= MIN_INTERVAL and beat_interval <= MAX_INTERVAL:\n\n                # BPM 계산식\n                # 1분은 60,000밀리초입니다.\n                # 60,000을 박동 간격으로 나누면 BPM이 됩니다.\n                # 예:  박동 간격이 1000ms이면 60000 ÷ 1000 = 60BPM입니다.\n                new_bpm = Math.round(60000 / beat_interval)\n\n                # 처음 계산한 BPM이라면 바로 저장합니다.\n                if bpm == 0:\n                    bpm = new_bpm\n\n                # 기존 BPM이 있다면 새로운 값과 섞어 평균을 냅니다.갑자기 숫자가 크게 바뀌는 현상을 줄여 줍니다.\n                else:\n                    bpm = Math.round((bpm * 3 + new_bpm) / 4)\n\n        # 현재 박동 시각을 다음 계산을 위해 저장합니다.\n        last_beat = now\n\n  # 8-3. 다음 박동을 감지할 준비 \n    # 센서값이 낮은 기준값 아래로 내려가면  현재 박동이 끝난 것으로 판단합니다.\n    if sensor_value < THRESHOLD_LOW:\n        beat_armed = True\n\n\n    # 8-4. 하트 표시 크기 되돌리기\n    # 큰 하트를 표시한 후 120ms가 지났으면 시 작은 하트로 변경합니다.\n    if heart_off_time"}]},{"timestamp":1785415241686,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":388,"diffs":[[1,""]]},{"start1":12,"length1":121,"diffs":[[1,""]]},{"start1":24,"length1":1182,"diffs":[[1,"let lastBeat = 0\nlet graph = 0\nlet bit = 0\n"]]},{"start1":86,"length1":504,"diffs":[[1,"OLED.clear()\nlet num = 1\nlet item = 63\nbasic.forever(function on_forever() {\n"]]},{"start1":168,"length1":0,"diffs":[[1,"    bit = Math.constrain(pins.analogReadPin(AnalogReadWritePin.P1), 200, 900)\n    graph = Math.map(bit, 200, 900, 62, 10)\n    OLED.drawLine(num, item, num + 1, graph)\n    control.waitMicros(1000)\n    num += 2\n    item = 