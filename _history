awLine(0, 16, 127, 16)\n"]]},{"start1":303,"length1":0,"diffs":[[1,"\n"]]},{"start1":466,"length1":0,"diffs":[[1,"//  이번에 새로 계산한 BPM입니다.\n//  2. 박동을 한 번만 감지하기 위한 변수\n//  센서값이 기준값을 넘었을 때 박동을 한 번만 세도록 합니다.\n//  True  : 새로운 박동을 감지할 준비가 된 상태\n//  False : 현재 박동을 이미 감지한 상태\n"]]},{"start1":638,"length1":115,"diffs":[[1,"//  큰 하트를 잠시 보여 준 작은 하트로 되돌릴 시간을 저장합니다.\n//  3. 심박 감지 기준값\n//  센서값이 이 값보다 커지면 박동이 시작된 것으로 판단합니다. 예제값인 600을 기본값으로 사용합니다.\n"]]},{"start1":805,"length1":179,"diffs":[[1,"//  센서값이 이 값보다 작아지면 다음 박동을 감지할 준비를 합니다.\n//  HIGH와 LOW를 다르게 설정하는 이유는 센서값이 600 근처에서 흔들릴 때 한 박동을 여러 번 세는현상을 줄이기 위해서입니다.\n//  4. 정상적인 BPM 범위\n//  300ms보다 빠르게 박동이 감지되면 1분에 200회보다 빠른 값이 됩니다.\n"]]},{"start1":1011,"length1":46,"diffs":[[1,"//  1500ms보다 느리게 박동이 감지되면 1분에 40회보다 느린 값이 됩니다.\n"]]},{"start1":1082,"length1":24,"diffs":[[1,"//  현재 그래프를 그릴 가로 위치입니다.\n"]]},{"start1":1124,"length1":34,"diffs":[[1,"//  현재 센서값을 OLED의 세로 좌표로 변환한 값입니다.\n"]]},{"start1":1179,"length1":86,"diffs":[[1,"//  바로 전에 그렸던 그래프의 세로 위치입니다.\n//  OLED 위쪽은 BPM 숫자를 표시하는 공간으로 남겨 둡니다.그래프는 y=20부터 y=63 사이에\n"]]},{"start1":1308,"length1":75,"diffs":[[1,"//  심박 센서값을 그래프로 변환할 때 사용할 범위\n//  200보다 작은 값은 200으로, 900보다 큰 값은 900으로 제한합니다.\n"]]},{"start1":1427,"length1":17,"diffs":[[1,"//  6. OLED 시작 설정\n"]]},{"start1":1464,"length1":0,"diffs":[[1,"//  OLED의 크기를 128×64로 설정합니다.\n//  두 번째 값 0은 아이콘을 표시한 뒤 기다리지 않는다는 뜻입니다.\n"]]},{"start1":1574,"length1":32,"diffs":[[1,"//  숫자 영역과 그래프 영역을 구분하는 선을 그립니다.\n"]]},{"start1":1621,"length1":173,"diffs":[[1,"//  프로그램 시작 시 OLED의 기본 화면을 한 번 그립니다.\n//  8. 심박수 측정 및 그래프 출력\n//  위에서 만든 함수를 계속 반복 실행합니다.\nbasic.forever(function on_forever() {\n    \n    //  8-1. 심박 센서값 읽기\n    //  P1 핀에 연결된 심박 센서의 아날로그 값을 읽습니다.\n"]]},{"start1":1875,"length1":38,"diffs":[[1,"    //  프로그램이 시작된 후 지금까지 지난 시간을 가져옵니다.\n"]]},{"start1":1944,"length1":76,"diffs":[[1,"    //  8-2. 새로운 박동 감지\n    //  센서값이 높은 기준값을 넘었고,새로운 박동을 감지할 준비가 되어 있는지 확인합니다.\n"]]},{"start1":2077,"length1":58,"diffs":[[1,"        //  현재 박동을 이미 감지했으므로 같은 박동을 다시 세지 않도록 False로 바꿉니다.\n"]]},{"start1":2206,"length1":31,"diffs":[[1,"        //  micro:bit LED에 큰 하트를 표시합니다.\n"]]},{"start1":2281,"length1":117,"diffs":[[1,"        //  120ms 후 작은 하트로 되돌리기 위해 시간을 기록합니다.\n        //  last_beat가 0이면 첫 번째 박동입니다.첫 번째 박동만으로는 박동 사이의 시간을 계산할 수 없습니다.\n"]]},{"start1":2473,"length1":100,"diffs":[[1,"            //  현재 박동 시각에서 이전 박동 시각을 뺍니다.\n            //  너무 빠르거나 너무 느린 신호는 센서 잡음일 수 있으므로 계산에서 제외합니다.\n"]]},{"start1":2657,"length1":177,"diffs":[[1,"                //  BPM 계산식\n                //  1분은 60,000밀리초입니다.\n                //  60,000을 박동 간격으로 나누면 BPM이 됩니다.\n                //  예:  박동 간격이 1000ms이면 60000 ÷ 1000 = 60BPM입니다.\n"]]},{"start1":2989,"length1":127,"diffs":[[1,"                    //  처음 계산한 BPM이라면 바로 저장합니다.\n                    //  기존 BPM이 있다면 새로운 값과 섞어 평균을 냅니다.갑자기 숫자가 크게 바뀌는 현상을 줄여 줍니다.\n"]]},{"start1":3198,"length1":0,"diffs":[[1,"                \n"]]},{"start1":3229,"length1":0,"diffs":[[1,"            \n"]]},{"start1":3252,"length1":38,"diffs":[[1,"        \n        //  현재 박동 시각을 다음 계산을 위해 저장합니다.\n"]]},{"start1":3330,"length1":76,"diffs":[[1,"    \n    //  8-3. 다음 박동을 감지할 준비\n    //  센서값이 낮은 기준값 아래로 내려가면  현재 박동이 끝난 것으로 판단합니다.\n"]]},{"start1":3485,"length1":73,"diffs":[[1,"    \n    //  8-4. 하트 표시 크기 되돌리기\n    //  큰 하트를 표시한 후 120ms가 지났으면 시 작은 하트로 변경합니다.\n"]]},{"start1":3668,"length1":19,"diffs":[[1,"        heart_off_time = 0\n"]]},{"start1":3701,"length1":98,"diffs":[[1,"    \n    //  8-5. 일정 시간 동안 박동이 없으면 BPM을 0으로 변경\n    //  2.5초 동안 새로운 박동이 감지되지 않으면 손가락이 센서에서 떨어진 것으로 판단합니다.\n"]]},{"start1":3879,"length1":67,"diffs":[[1,"    \n    //  8-6. 센서값을 그래프의 세로 좌표로 변환\n    //  너무 작거나 큰 센서값을 일정 범위로 제한합니다.\n"]]},{"start1":4026,"length1":128,"diffs":[[1,"    //  센서값 200~900을 OLED의 y좌표 63~20으로 변환합니다.\n    //  \n    //  OLED는 위쪽이 y=0이고 아래쪽이 y=63입니다.\n    //  센서값이 커질수록 그래프가 위로 올라가도록 변환합니다.\n"]]},{"start1":4257,"length1":66,"diffs":[[1,"    //  8-7. OLED에 심박 그래프 그리기\n    //  그래프가 OLED 오른쪽 끝에 도착했는지 확인합니다.\n"]]},{"start1":4373,"length1":37,"diffs":[[1,"        //  화면을 지우고 최신 BPM을 다시 표시합니다.\n"]]},{"start1":4431,"length1":37,"diffs":[[1,"        //  그래프를 왼쪽 처음 위치에서 다시 시작합니다.\n"]]},{"start1":4511,"length1":107,"diffs":[[1,"        OLED.drawLine(graph_x, previous_y, graph_x + 2, graph_y)\n"]]},{"start1":4582,"length1":79,"diffs":[[1,"    \n    //  이전 위치와 현재 위치를 선으로 연결합니다.\n    //  이렇게 하면 점만 표시하는 것보다 연속된 심박 파형처럼 보이게 됩니다.\n"]]},{"start1":4685,"length1":31,"diffs":[[1,"    //  다음 그래프를 오른쪽으로 2픽셀 이동합니다\n"]]},{"start1":4742,"length1":99,"diffs":[[1,"    //  현재 y좌표를 다음 선의 시작점으로 저장합니다.\n    //  8-8. 측정 속도 조절\n    //  20ms 동안 기다립니다. 약 1초에 50번 센서값을 측정합니다.\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":25,"diffs":[[1,"    \"name\": \"심박측정fi\",\n"]]},{"start1":320,"length1":79,"diffs":[[1,"    \"preferredEditor\": \"pyprj\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// 테스트는 여기로 이동합니다; 이 패키지가 확장으로 사용될 때 컴파일되지 않을 것 입니다.\n"}]}],"snapshots":[{"timestamp":1752251114178,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"111\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1753804509818,"editorVersion":"8.0.11","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"6@aOr3-Z{-w#XbrwjU9g\">bit</variable><variable id=\":vaEIH{o0+6wY{7=4SZ$\">graph</variable><variable id=\"K8tEnly6A$;%P$@R~A3G\">num</variable><variable id=\"=kc60;!SM{34|`swMa`y\">item</variable><variable id=\"pT=oph]b=@M{wtvRth17\">lastBeat</variable><variable id=\"]=t~i61LAN;}DpE?F4y+\">now</variable><variable id=\"0|i~5ks:GWeKvNKL+L*u\">bpm</varia